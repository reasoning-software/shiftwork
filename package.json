{
	"name": "shiftwork",
	"version": "0.1.0",
	"type": "module",
	"description": "Agent-agnostic CLI orchestration platform for AI coding agents",
	"bin": {
		"shiftwork": "./src/index.ts"
	},
	"exports": {
		".": "./src/index.ts",
		"./config": "./src/config/define-config.ts"
	},
	"scripts": {
		"dev": "bun run src/index.ts",
		"test": "bun test",
		"test:watch": "bun test --watch",
		"check": "biome check .",
		"check:fix": "biome check --fix .",
		"typecheck": "tsc --noEmit",
		"build": "bun build src/index.ts --outdir dist --target node"
	},
	"dependencies": {
		"commander": "^13.0.0",
		"ink": "^5.1.0",
		"react": "^18.3.1",
		"zod": "^3.24.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.0",
		"@types/bun": "latest",
		"@types/react": "^18.3.0",
		"typescript": "^5.7.0"
	}
}
