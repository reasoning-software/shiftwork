{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"verbatimModuleSyntax": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"outDir": "dist",
		"rootDir": ".",
		"paths": {
			"@shiftwork/runtime/*": ["./src/runtime/*"],
			"@shiftwork/engine/*": ["./src/engine/*"],
			"@shiftwork/ui/*": ["./src/ui/*"],
			"@shiftwork/types": ["./src/types/index.ts"],
			"@shiftwork/config": ["./src/config/define-config.ts"]
		}
	},
	"include": ["src/**/*.ts", "src/**/*.tsx", "tests/**/*.ts"],
	"exclude": ["node_modules", "dist"]
}
